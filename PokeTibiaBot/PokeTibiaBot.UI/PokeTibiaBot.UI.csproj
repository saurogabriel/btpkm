<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>PokeTibiaBot</AssemblyName>
    <RootNamespace>PokeTibiaBot</RootNamespace>
    <ApplicationIcon></ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="System.Text.Json" Version="8.0.0" />
  </ItemGroup>

  <!--
    Copia PokeTibiaBot.Native.dll para o output. Procura em Release e Debug do
    projeto nativo. Se nenhuma for encontrada, o build FALHA com mensagem clara
    (evita rodar o app sem a DLL e crashar em runtime).
  -->
  <Target Name="CopyNativeDll" AfterTargets="Build">
    <PropertyGroup>
      <NativeRelease>..\PokeTibiaBot.Native\x64\Release\PokeTibiaBot.Native.dll</NativeRelease>
      <NativeDebug>..\PokeTibiaBot.Native\x64\Debug\PokeTibiaBot.Native.dll</NativeDebug>
    </PropertyGroup>
    <Copy Condition="Exists('$(NativeRelease)')"
          SourceFiles="$(NativeRelease)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" />
    <Copy Condition="!Exists('$(NativeRelease)') And Exists('$(NativeDebug)')"
          SourceFiles="$(NativeDebug)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" />
    <Error Condition="!Exists('$(NativeRelease)') And !Exists('$(NativeDebug)')"
           Text="PokeTibiaBot.Native.dll não encontrado. Compile o projeto PokeTibiaBot.Native em x64 primeiro (Build Order: Nativo antes do UI)." />
  </Target>
</Project>
