<Window x:Class="PokeTibiaBot.Views.MemoryScannerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Memory Scanner (CE-style)"
        Width="640" Height="560"
        Background="{StaticResource BgPrimary}"
        WindowStartupLocation="CenterOwner"
        FontFamily="Consolas">
    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top"
                   Text="🔎 MEMORY SCANNER"
                   FontSize="18" FontWeight="Bold"
                   Foreground="{StaticResource AccentGold}" Margin="0,0,0,8"/>

        <GroupBox DockPanel.Dock="Top" Header="1. Anexar processo">
            <StackPanel Orientation="Horizontal">
                <Label Content="Processo:"/>
                <TextBox x:Name="ProcessNameTb" Text="PokeTibia.exe" Width="200"/>
                <Button Content="Anexar" Click="OnAttach" Margin="8,0,0,0"/>
                <Button Content="Desanexar" Click="OnDetach" Margin="4,0,0,0"/>
                <TextBlock x:Name="StatusTxt" Text="não anexado"
                           Foreground="{StaticResource AccentRed}"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>
        </GroupBox>

        <GroupBox DockPanel.Dock="Top" Header="2. Escanear (Int32)">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <Label Content="Valor:"/>
                    <TextBox x:Name="ValueTb" Text="100" Width="120"/>
                    <Button Content="First Scan" Click="OnFirstScan" Margin="8,0,0,0"/>
                    <Button Content="Next: = valor" Click="OnNextEqual" Margin="4,0,0,0"/>
                    <Label Content="Max:" Margin="8,0,0,0"/>
                    <TextBox x:Name="MaxTb" Text="500000" Width="80"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Text="Comparar com scan anterior:" VerticalAlignment="Center"/>
                    <Button Content="Igual" Click="OnCmpUnchanged" Margin="8,0,0,0"/>
                    <Button Content="Mudou" Click="OnCmpChanged" Margin="4,0,0,0"/>
                    <Button Content="Aumentou" Click="OnCmpInc" Margin="4,0,0,0"/>
                    <Button Content="Diminuiu" Click="OnCmpDec" Margin="4,0,0,0"/>
                    <TextBlock x:Name="CountTxt" Text="0 resultados"
                               Foreground="{StaticResource AccentGold}"
                               FontWeight="Bold"
                               VerticalAlignment="Center" Margin="16,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <GroupBox DockPanel.Dock="Bottom" Header="Instruções" Padding="8">
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" FontSize="11">
                Como achar o offset do seu HP:
                1) Anexe ao processo do cliente do jogo.
                2) Note seu HP atual (ex: 500). Digite no campo Valor e clique "First Scan".
                3) Volte ao jogo, tome um dano e mude o HP. Digite o novo valor e "Next: = valor" — ou use "Diminuiu".
                4) Repita até ficarem ~1-5 endereços. Anote o endereço e configure em BotProfile.
            </TextBlock>
        </GroupBox>

        <DataGrid x:Name="ResultsGrid"
                  AutoGenerateColumns="False"
                  Background="{StaticResource BgSecondary}"
                  Foreground="{StaticResource TextPrimary}"
                  RowBackground="{StaticResource BgTertiary}"
                  AlternatingRowBackground="{StaticResource BgSecondary}"
                  HeadersVisibility="Column"
                  CanUserAddRows="False"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="50"/>
                <DataGridTextColumn Header="Endereço (hex)" Binding="{Binding HexAddress}" Width="200"/>
                <DataGridTextColumn Header="Valor atual" Binding="{Binding Value}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
