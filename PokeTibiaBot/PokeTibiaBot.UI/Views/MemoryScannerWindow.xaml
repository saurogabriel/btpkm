<Window x:Class="PokeTibiaBot.Views.MemoryScannerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Memory Scanner (CE-style)"
        Width="720" Height="620"
        Background="{StaticResource BgPrimary}"
        WindowStartupLocation="CenterOwner"
        FontFamily="Consolas">
    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top"
                   Text="🔎 MEMORY SCANNER"
                   FontSize="18" FontWeight="Bold"
                   Foreground="{StaticResource AccentGold}" Margin="0,0,0,8"/>

        <GroupBox DockPanel.Dock="Top" Header="1. Anexar processo">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Label Content="Processo:"/>
                    <ComboBox x:Name="ProcessCombo" Width="330"
                              IsEditable="True"
                              DisplayMemberPath="Display"
                              ToolTip="Selecione ou digite o nome exato (com .exe)"/>
                    <Button Content="↻" Click="OnRefreshProcs" Margin="4,0,0,0"
                            ToolTip="Recarregar lista de processos"/>
                    <Button Content="Anexar" Click="OnAttach" Margin="4,0,0,0"/>
                    <Button Content="Desanexar" Click="OnDetach" Margin="4,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="StatusTxt" Text="não anexado"
                           Foreground="{StaticResource AccentRed}"
                           Margin="0,4,0,0" FontWeight="Bold"/>
            </StackPanel>
        </GroupBox>

        <GroupBox DockPanel.Dock="Top" Header="2. Escanear (Int32)">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <Label Content="Valor:"/>
                    <TextBox x:Name="ValueTb" Text="100" Width="120"/>
                    <Button x:Name="FirstScanBtn" Content="First Scan" Click="OnFirstScan" Margin="8,0,0,0"/>
                    <Button x:Name="NextScanBtn" Content="Next: = valor" Click="OnNextEqual" Margin="4,0,0,0"/>
                    <Label Content="Max:" Margin="8,0,0,0"/>
                    <TextBox x:Name="MaxTb" Text="500000" Width="80"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Text="Comparar:" VerticalAlignment="Center"/>
                    <Button Content="Igual" Click="OnCmpUnchanged" Margin="8,0,0,0"/>
                    <Button Content="Mudou" Click="OnCmpChanged" Margin="4,0,0,0"/>
                    <Button Content="Aumentou" Click="OnCmpInc" Margin="4,0,0,0"/>
                    <Button Content="Diminuiu" Click="OnCmpDec" Margin="4,0,0,0"/>
                    <TextBlock x:Name="CountTxt" Text="0 resultados"
                               Foreground="{StaticResource AccentGold}"
                               FontWeight="Bold"
                               VerticalAlignment="Center" Margin="16,0,0,0"/>
                    <ProgressBar x:Name="Busy" Width="120" Height="14" Margin="12,0,0,0"
                                 IsIndeterminate="False" Visibility="Collapsed"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <GroupBox DockPanel.Dock="Bottom" Header="Ajuda" Padding="8">
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" FontSize="11">
                <Run FontWeight="Bold">Dicas:</Run>
                <LineBreak/>• Se o attach falhar, feche o bot e reabra <Run FontWeight="Bold">como Administrador</Run>.
                <LineBreak/>• Se a lista de processos estiver vazia, clique em ↻ pra recarregar.
                <LineBreak/>• Se travar durante o "First Scan", diminua o valor de <Run FontWeight="Bold">Max</Run> (ex: 100000).
                <LineBreak/>• Alguns clientes protegem a memória e retornam 0 matches — isso é esperado, não é bug.
            </TextBlock>
        </GroupBox>

        <DataGrid x:Name="ResultsGrid"
                  AutoGenerateColumns="False"
                  Background="{StaticResource BgSecondary}"
                  Foreground="{StaticResource TextPrimary}"
                  RowBackground="{StaticResource BgTertiary}"
                  AlternatingRowBackground="{StaticResource BgSecondary}"
                  HeadersVisibility="Column"
                  CanUserAddRows="False"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="50"/>
                <DataGridTextColumn Header="Endereço (hex)" Binding="{Binding HexAddress}" Width="220"/>
                <DataGridTextColumn Header="Valor atual" Binding="{Binding Value}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
